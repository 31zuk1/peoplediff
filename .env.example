OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults to gpt-4.1-nano. Repairs non-Japanese UI analysis text before snapshots are saved.
OPENAI_REPAIR_MODEL=gpt-4.1-nano

# Optional. Caps OpenAI enrichment per side during refresh.
PEOPLEDIFF_AI_ARTICLE_LIMIT=

# Optional. Defaults to ./data/snapshots in local/server environments.
# Vercel serverless filesystem writes are not durable; use a real storage adapter for production history.
PEOPLEDIFF_DATA_DIR=

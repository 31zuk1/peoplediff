OPENAI_API_KEY=

# Required for POST /api/refresh. Send as: Authorization: Bearer <token>
PEOPLEDIFF_ADMIN_TOKEN=

# Required for /api/cron/refresh. Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=

# Optional. Comma/space-separated target languages refreshed by cron. Defaults to JP.
PEOPLEDIFF_CRON_TARGETS=JP

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults to gpt-4.1-nano. Repairs non-Japanese UI analysis text before snapshots are saved.
OPENAI_REPAIR_MODEL=gpt-4.1-nano

# Optional. Caps OpenAI enrichment per side during refresh.
PEOPLEDIFF_AI_ARTICLE_LIMIT=

# Optional. Default public view merges the most recent 7 daily snapshots.
PEOPLEDIFF_READ_WINDOW_DAYS=7

# Optional. Defaults: OpenAI 6, scraping 16.
PEOPLEDIFF_AI_CONCURRENCY=
PEOPLEDIFF_SCRAPE_CONCURRENCY=

# Optional. Cron-specific refresh caps.
PEOPLEDIFF_CRON_LIMIT=
PEOPLEDIFF_CRON_MAX_PAGES=
PEOPLEDIFF_CRON_MAX_ARTICLES=
PEOPLEDIFF_CRON_AI_ARTICLE_LIMIT=
PEOPLEDIFF_CRON_SOURCE_LOOKBACK_DAYS=3
PEOPLEDIFF_CRON_ROLLING_DAYS=7
PEOPLEDIFF_CRON_LATEST_OFFSET=0
PEOPLEDIFF_REFRESH_LOCK_TTL_SECONDS=600

# Optional. Used only by the local file snapshot store. Defaults to ./data/snapshots.
# Prefer an absolute path when overriding.
PEOPLEDIFF_DATA_DIR=

# Optional. Defaults to local file storage unless BLOB_READ_WRITE_TOKEN is set.
# Set to "blob" to require Vercel Blob storage, or "file" to force local file storage.
PEOPLEDIFF_STORAGE=

# Optional. Enables Vercel Blob snapshot storage when present.
BLOB_READ_WRITE_TOKEN=

# Optional. Folder prefix inside the Blob store. Defaults to snapshots/
PEOPLEDIFF_BLOB_PREFIX=
